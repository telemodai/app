{
  "name": "tg-moderator-ai",
  "version": "1.5.0",
  "description": "Telegram AI Moderator Bot - автоматическая модерация чатов с помощью искусственного интеллекта",
  "type": "module",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Valerii Tikhomirov <v.tikhomirov.dev+npm@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/telemodai/app"
  },
  "keywords": [
    "telegram",
    "bot",
    "moderator",
    "ai",
    "openai",
    "nuxt",
    "vue",
    "typescript"
  ],
  "scripts": {
    "build": "nuxt build && bun run build:cli",
    "build:cli": "bun scripts/build-cli.ts",
    "cli": "bun --env-file=.env scripts/cli-entry.ts",
    "dev": "bun --env-file=.env run db:migrate && nuxt dev",
    "predev": "bun scripts/sync-brand-public.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=.env scripts/db-migrate.ts",
    "release:notes": "bun scripts/collect-release-notes.ts"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/geologica": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@nuxtjs/i18n": "10.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "chart.js": "^4.5.1",
    "commander": "^14.0.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.0.3",
    "openai": "^5.12.2",
    "pino": "^9.8.0",
    "pino-pretty": "^13.1.1",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.18",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.5.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "drizzle-kit": "^0.31.10"
  }
}
