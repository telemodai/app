{
  // Human-readable name shown in the Cloud Agents dashboard.
  "name": "tg-moderator-ai (Telemodai)",

  "install": "bash .cursor/environment/scripts/install.sh",
  "start": "bash .cursor/environment/scripts/start.sh",

  // Long-running foreground processes with visible, restartable logs.
  "terminals": [
    {
      "name": "dev",
      "description": "Nuxt dev server (admin UI + API) on port 3001.",
      "command": "bash .cursor/environment/scripts/dev.sh"
    },
    {
      "name": "tunnel",
      "description": "Idle placeholder — Cloudflare tunnel is started on demand via make tunnel (see AGENTS.md).",
      "command": "echo 'Tunnel off by default. When asked: tmux new-session -d -s cloudflared-tunnel -c /workspace -- make tunnel'; sleep infinity"
    }
  ],

  // Expose the dev server port so Cursor auto-forwards it to your localhost.
  "ports": [
    { "name": "nuxt-dev", "port": 3001 }
  ]
}
