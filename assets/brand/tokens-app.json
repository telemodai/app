{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "description": "App-only moderation action colors. Not synced to site/brand upstream.",
  "action": {
    "warning": { "dark": "oklch(0.78 0.14 85)", "light": "oklch(0.52 0.12 75)" },
    "delete": { "dark": "oklch(0.72 0.13 48)", "light": "oklch(0.50 0.12 45)" },
    "ban": { "dark": "var(--tm-danger)", "light": "var(--tm-danger)" },
    "reset": { "dark": "oklch(0.68 0.11 255)", "light": "oklch(0.42 0.09 255)" },
    "unban": { "dark": "oklch(0.72 0.09 155)", "light": "oklch(0.45 0.08 155)" },
    "pardon": { "dark": "oklch(0.70 0.08 220)", "light": "oklch(0.44 0.07 220)" }
  }
}
